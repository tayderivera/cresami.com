        CSS
        .img-container .tim-logo{
    width: auto;
    height: 40px;
}
.img-container .fag-logo{
    width: auto;
    height: 50px;
}
.img-container .nachi-logo{
    width: auto;
    height: 40px;
}
.img-container img{
    width: auto;
    height: 70px;
    filter: grayscale(100%);
     transition-property: filter;
    transition-duration: 0.3s;
    
}
.img-container img:hover{
    filter: grayscale(0%);
    transition-property: filter;
    transition-duration: 0.3s;
    cursor: pointer;
    
}
